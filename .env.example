# Out Past — optional cloud endpoints.
#
# KAI, the built-in AI mentor, works FULLY LOCALLY without any of these. You do
# not need an API key or an internet connection for the core app. These variables
# only switch on optional cloud features (cross-device sync and an optional cloud
# AI/scheduling worker). Left blank, those features quietly disable themselves and
# everything else keeps working.
#
# To use them: copy this file to .env and fill in your own endpoints.

# Optional AI / scheduling worker (KAI cloud planning, membership, keyed YouTube
# search, booking scheduler). Bring your own endpoint.
VITE_GAI_WORKER_URL=

# Optional cross-device account / sync backend. Bring your own endpoint.
VITE_SYNC_API=
